{
  "name": "igrek",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "igrek": "apps/server/src/cli.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@igrek/server' dev & bun run --filter '@igrek/web' dev",
    "build": "bun run --filter '@igrek/web' build",
    "start": "bun run apps/server/src/index.ts",
    "doctor": "bun run apps/server/src/cli.ts doctor",
    "igrek": "bun run apps/server/src/cli.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:dead": "knip --no-progress && bun scripts/dead-keys.ts",
    "lint:arch": "bun scripts/arch-check.ts",
    "lint:db": "bun scripts/db-check.ts",
    "lint:quality": "bun scripts/code-check.ts",
    "lint:bundle": "bun scripts/bundle-check.ts",
    "c4": "bun scripts/c4.ts",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "knip": "6.39.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "@openuidev/devtools": "0.2.2",
    "lucide-react": "^1.58.0"
  }
}
