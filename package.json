{
  "name": "igrek",
  "version": "0.1.3",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "igrek": "apps/server/src/cli.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@igrek/server' dev & bun run --filter '@igrek/web' dev",
    "build": "bun run --filter '@igrek/web' build",
    "start": "bun run apps/server/src/index.ts",
    "doctor": "bun run apps/server/src/cli.ts doctor",
    "igrek": "bun run apps/server/src/cli.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:dead": "knip --no-progress && bun scripts/dead-keys.ts",
    "lint:arch": "bun scripts/arch-check.ts",
    "lint:db": "bun scripts/db-check.ts",
    "lint:quality": "bun scripts/code-check.ts",
    "lint:bundle": "bun scripts/bundle-check.ts",
    "c4": "bun scripts/c4.ts",
    "format": "biome format --write .",
    "test": "bun test",
    "test:e2e": "bun test ./scripts/e2e/browser.e2e.ts",
    "test:crawl": "bun test ./scripts/e2e/crawl.e2e.ts",
    "test:all": "biome check . && bun run typecheck && bun run lint:dead && bun run lint:arch && bun run lint:db && bun run lint:quality && bun test && bun run build && bun run lint:bundle && bun run test:e2e && bun run test:crawl"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "knip": "6.39.0",
    "playwright-core": "1.63.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "@openuidev/devtools": "0.2.2",
    "lucide-react": "^1.58.0"
  }
}
