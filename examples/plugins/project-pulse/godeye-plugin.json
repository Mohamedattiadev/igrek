{
  "id": "project-pulse",
  "name": "Project pulse",
  "version": "1.0.0",
  "description": "A table of your projects with their health, sessions and how much memory God Eye keeps for each. An example of a God Eye plugin.",
  "author": "God Eye",
  "permissions": ["projects:read", "memory:read"],
  "panels": [
    { "id": "pulse", "title": "Project pulse", "entry": "panel.html", "place": "tools" },
    { "id": "memory", "title": "Memory at a glance", "entry": "memory.html", "place": "project" }
  ],
  "commands": [
    {
      "id": "loc",
      "title": "Count lines of code",
      "run": ["sh", "-c", "git ls-files | xargs wc -l 2>/dev/null | tail -1"]
    }
  ]
}
