{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "apps/server": {
      "entry": ["src/desktop.ts", "src/embed-worker.ts", "src/preview/agent.js", "src/preview/vite-source-plugin.mjs"],
      "ignoreDependencies": ["@playwright/mcp", "axe-core"]
    },
    "apps/desktop": {
      "entry": ["scripts/*.ts"]
    },
    "packages/learn": {
      "entry": ["scripts/*.ts"]
    }
  },
  "ignore": ["examples/**", "extension/**"]
}
