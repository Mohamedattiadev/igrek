# Copy to .env and adjust. All values are optional.
# Older .env files with GODEYE_* names keep working.

# Folder that contains your projects (mounted into the container at the same path).
IGREK_PROJECTS_DIR=/home/you/projects

# Your user and group id (run `id -u` and `id -g`). Keeps file ownership correct.
IGREK_UID=1000
IGREK_GID=1000

# Port on this computer.
IGREK_PORT=7777

# Bake Claude Code into the image (true/false).
IGREK_INSTALL_CLAUDE=false
